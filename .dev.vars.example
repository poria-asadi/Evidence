# Copy this file to .dev.vars. Never commit the real .dev.vars file.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_GPT_MODEL=openai/gpt-6-luna
OPENROUTER_ADJUDICATOR_MODEL=anthropic/claude-sonnet-5
OPENROUTER_FULLTEXT_ADJUDICATOR_MODEL=openai/gpt-5.6-sol
APP_PUBLIC_URL=http://localhost:3000

# Local-only identity. Do not enable this in hosted or production settings.
LOCAL_DEV_AUTH=true
LOCAL_DEV_USER_ID=local-researcher
LOCAL_DEV_USER_EMAIL=researcher@localhost
